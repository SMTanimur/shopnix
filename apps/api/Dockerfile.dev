FROM node:22-alpine

# Install build dependencies for native modules and curl for health checks
RUN apk add --no-cache python3 make g++ curl bash

# Install Bun
RUN npm install -g bun@1.2.17

WORKDIR /app

# Copy root configurations and workspace definitions
COPY package.json turbo.json bun.lock* ./
COPY apps/api/package.json ./apps/api/
COPY packages/types/package.json ./packages/types/
COPY packages/schemas/package.json ./packages/schemas/
COPY packages/utils/package.json ./packages/utils/
COPY packages/api-client/package.json ./packages/api-client/

# Install workspace dependencies inside Linux container
RUN bun install

# Copy source trees
COPY packages ./packages
COPY apps/api ./apps/api

WORKDIR /app/apps/api

# Create logs directory
RUN mkdir -p logs/controllers

# Expose API port 8000
EXPOSE 8000

# File polling configuration for cross-platform Docker file watching (Windows host -> Linux container)
ENV CHOKIDAR_USEPOLLING=true
ENV WATCHPACK_POLLING=true
ENV LOG_DIR=/app/apps/api/logs

# Start NestJS in development watch mode for live instant reloading on code change
CMD ["bun", "run", "dev"]
