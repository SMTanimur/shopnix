# ===================================================
# SHOPNIX ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before starting services
# ===================================================

# Server Configuration (Standardized Ports: API 8000, Web 5000)
NODE_ENV=development
PORT=8000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5000

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/shopnix

# Redis (Refresh Tokens, Rate Limiting & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Authentication (Merchant JWT)
JWT_SECRET=super-secret-jwt-access-token-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=super-secret-jwt-refresh-token-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRATION=7d

# Super Admin Authentication (Separate Security Realm)
ADMIN_JWT_SECRET=super-secret-admin-jwt-token-key-change-in-production-min-32
ADMIN_JWT_EXPIRATION=12h

# AES-256 Credential Encryption Key (32 hex characters)
ENCRYPTION_KEY=shopnix_aes_256_master_key_secret_32b!

# Frontend Application
NEXT_PUBLIC_APP_NAME=Shopnix
NEXT_PUBLIC_APP_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# AI Provider API Keys (Platform Managed Defaults)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Omnichannel Messaging Credentials
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=shopnix_wa_webhook_verify_token
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=shopnix_fb_webhook_verify_token

# Courier Sandbox & Provider Credentials (Optional Defaults)
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1
PATHAO_BASE_URL=https://api-hermes.pathao.com
REDX_BASE_URL=https://openapi.redx.com.bd/v1.0.0-beta
ECOURIER_BASE_URL=https://backoffice.ecourier.com.bd/api
